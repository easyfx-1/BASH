#!/bin/bash

url="$1"
pasta="musicas"

if [ -z "$url" ]; then
    echo "Uso: $0 <URL-do-YouTube>"
    exit 1
fi

if ! command -v yt-dlp >/dev/null 2>&1; then
    echo "Erro: yt-dlp não está instalado."
    exit 1
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "Erro: ffmpeg não está instalado."
    exit 1
fi

if ! command -v deno >/dev/null 2>&1; then
    echo "Erro: Deno não está instalado ou não está no PATH."
    exit 1
fi

mkdir -p "$pasta"

if yt-dlp \
    --no-playlist \
    --js-runtimes deno \
    --remote-components ejs:npm \
    --extract-audio \
    --audio-format mp3 \
    --audio-quality 0 \
    --embed-metadata \
    --output "$pasta/%(title)s.%(ext)s" \
    "$url"
then
    echo "MP3 salvo em: $PWD/$pasta"
else
    echo "Erro: o download ou a conversão falhou."
    exit 1
fi
