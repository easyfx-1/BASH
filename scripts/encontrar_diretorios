#!/bin/bash

url="$1"
wordlist="COLOQUE SUA WORD LIST AQUI"

if [ -z "$url" ]; then
    echo "Uso: $0 <url>"
    exit 1
fi

while read -r palavra; do
    resposta=$(curl -s \
        -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 Edg/120.0.0.0" \
        -o /dev/null \
        -w "%{http_code}" \
        "$url/$palavra/")

    if [ "$resposta" = "200" ]; then
        echo "Diretorio encontrado: $url/$palavra/"
    fi
done < "$wordlist"
